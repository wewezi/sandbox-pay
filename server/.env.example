PORT=3000

# API 文档默认关闭，避免公开暴露接口结构；仅在受控开发环境按需开启
ENABLE_API_DOCS=false

# Client URL
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=sandbox_pay
# WARNING: 生产环境必须设为 false，使用迁移脚本管理表结构
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (生产环境请使用足够长度的随机串，例如 `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_here
# Token 有效期（默认 1440m = 24 小时）
JWT_EXPIRES_IN=1440m

# Gateway (商户接入签名密钥)
GATEWAY_SECRET=your_gateway_secret_here

# 商户 appSecret 等敏感字段的 AES-256-GCM 加密密钥
# 必须为 32 字节，可填 hex(64位) / base64 / 任意字符串（会做 SHA-256 派生）
# 生成示例：openssl rand -hex 32
# 未设置时会自动从 JWT_SECRET 派生（仅适用于开发，生产必填）
ENCRYPTION_KEY=

# Alipay 密钥
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# PayPal 密钥
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SMTP 密码
SMTP_PASS=

# 数据库连接池大小（默认 10）
# DB_POOL_SIZE=10

# ============================================================
# 以下业务配置已迁移到数据库站点设置，通过管理后台「站点设置」页面管理：
# - ENABLE_SANDBOX, THROTTLE_TTL_MS, THROTTLE_LIMIT
# - FEE_RATE_*, CHANNEL_COST_*, FEE_MIN_CENTS
# - EXCHANGE_RATE_*, FALLBACK_CNY_TO_USD
# - NATIVE_PAY_*
# - SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_FROM
# - PAYPAL_ENVIRONMENT
# 首次启动时自动写入默认值，之后全部从 DB 读取。
# ============================================================
