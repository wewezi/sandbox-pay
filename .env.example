PORT=18080

# 本机留空，保留 Vite 按 dev / build 确定模式
# HTTPS 部署时为后端进程设置 NODE_ENV=production，登录 Cookie 将要求 HTTPS
NODE_ENV=

# Vite 开发代理：默认跟随上面的 PORT；Go 后端在其他地址时填写完整 URL
# 仅供 npm run dev 使用，不改变 Go 服务监听地址
VITE_API_TARGET=

# 对外可访问的地址，用于拼收银台链接和支付宝 notify_url
# 前端已和后端同源，本地开发留空即可（用请求自身的 baseUrl）
# 需要让支付宝沙箱回调打进来时，填内网穿透地址，例如 https://xxx.ngrok.app
CLIENT_URL=

# Database (SQLite) — 相对路径按仓库根解析，留空则用 data/sandbox-pay.db
# 首次建表，后续由 internal/db/migrations.go 按版本自动事务升级；升级前先备份
DB_FILE=data/sandbox-pay.db

# JWT — 必填；用 `openssl rand -hex 32` 生成。少于32字节、占位/重复值会拒绝启动
JWT_SECRET=
# Token 有效期（1440m 或 24h；纯数字按秒计；无效配置回落24小时）
JWT_EXPIRES_IN=1440m

# 仅手动执行 create-admin 时使用，普通服务启动不会创建用户或重置密码；命令参数优先
# 用户名和密码留空即可；角色支持 Admin / SuperAdmin，省略角色默认 SuperAdmin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=SuperAdmin

# ------------------------------------------------------------
# 默认项目的第一把 API 令牌（仅哈希存库）
#
# 入站：接入方带 Authorization: Bearer <apiKey> 调网关。
# 出站：新订单使用独立项目回调密钥，后台项目设置可查看；升级前订单保留签名快照。
# 留空则首次启动随机生成令牌，只在首次生成时写到日志；完整令牌无法从哈希恢复。
# 重启复用库中凭证记录，无需抄回 .env；人工停用不会被重启或列表读取撤销。
#
# 这两个值只在首次初始化空库时用一次。之后新建项目、签发/停用令牌在「API令牌」页操作，
# 不用重启也不用改这里。
# ------------------------------------------------------------
GROUP_NAME=Mintweft Default Project
GROUP_API_KEY=

# ------------------------------------------------------------
# 渠道凭证：留空即该渠道不可用，调用时报「未配置」，不影响启动
# ------------------------------------------------------------
# Alipay 沙箱
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# PayPal 仅支持 sandbox，拒绝 live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ------------------------------------------------------------
# 业务配置，以下均为默认值，不需要改就整段删掉
# ------------------------------------------------------------
# 演示开关：关闭沙箱确认、测试下单、场景/回调模拟和数据重置；有效令牌网关仍可调用
ENABLE_SANDBOX=true

# 种子数据预览：暂停自动回调、延迟场景、订单过期和运维任务，手动管理操作仍可用
# 使用 seed-demo --replace 后设为 true 并启动服务；正常联调保留 false
DEMO_DATA_MODE=false

# 自动备份目录：留空使用数据库同目录的 backups；只管理程序生成的备份文件
# 保留时长、备份间隔和份数在「运行维护」页设置，默认每天备份、保留7份
BACKUP_DIR=
# 备份附带的配置文件：留空复制 .env；不改变服务启动时读取 .env 的规则
# 通过进程环境注入的配置不会写入此副本，需要由部署方另行保留
CONFIG_FILE=

# 退款重试须复用 orderNo + requestId；处理租期2分钟。
# 无上游流水号的未知结果超过首次请求30分钟须人工对账，详见 README「退款与重试」。
# 这些安全期限为程序固定规则，不是可调配置项。

# 默认只允许向公有网络地址发送通知。调试 localhost/内网接入方时明确设 true
NOTIFY_ALLOW_PRIVATE_NETWORK=false

# 可信反向代理的来源CIDR，逗号分隔。空值忽略所有 X-Forwarded-* 头
# 例：同机反代使用 127.0.0.1/32,::1/128；仅信任自管代理且由代理正确写入转发头
TRUSTED_PROXY_CIDRS=

# 调试日志：留空关闭，任何非空值都会开启（需要时填 1）
DEBUG=
# LOG_SILENT=1 只识别启动进程的环境变量，不从本文件加载；无需为本地预览设置

# 限流窗口与配额
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# 手续费率与渠道成本，小数表示（0.006 = 0.6%）
FEE_RATE_ALIPAY=0.006
FEE_RATE_PAYPAL=0.044
FEE_RATE_NATIVE=0
CHANNEL_COST_ALIPAY=0.006
CHANNEL_COST_PAYPAL=0.044
CHANNEL_COST_NATIVE=0
# 单笔最低手续费，单位「分」
FEE_MIN_CENTS=0

# 汇率：拉取失败时用 FALLBACK_CNY_TO_USD，MARGIN 为倍数（1 = 不加价）
EXCHANGE_RATE_PROVIDER=open-er-api
EXCHANGE_RATE_CACHE_TTL_MS=3600000
FALLBACK_CNY_TO_USD=0.14
EXCHANGE_RATE_MARGIN=1

# NATIVE 为本地模拟 / 人工核销；以下信息仅用于收银台展示，不会自动核验银行到账
# 填入已配置的收款二维码 URL；留空不展示收款二维码
NATIVE_PAY_QR_URL=
# 默认仅为品牌展示名；转账场景请填写实际收款户名
NATIVE_PAY_ACCOUNT_NAME=Mintweft Official
# 必须填写真实收款账号与开户银行，没有则留空
NATIVE_PAY_ACCOUNT_NO=
NATIVE_PAY_BANK_NAME=
