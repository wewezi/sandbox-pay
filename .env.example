PORT=3000

# 对外可访问的地址，用于拼收银台链接和支付宝 notify_url
# 前端已和后端同源，本地开发留空即可（用请求自身的 baseUrl）
# 需要让支付宝沙箱回调打进来时，填内网穿透地址，例如 https://xxx.ngrok.app
CLIENT_URL=

# Database (SQLite) — 相对路径按仓库根解析，留空则用 data/sandbox-pay.db
# 表结构在首次连库时由 internal/db/schema.go 建好，无需迁移脚本
DB_FILE=data/sandbox-pay.db

# JWT (生产环境请使用足够长度的随机串，例如 `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_here
# Token 有效期（默认 1440m = 24 小时）
JWT_EXPIRES_IN=1440m

# ------------------------------------------------------------
# 种子分组的第一把 API Key（明文存库）
#
# 一把 Key 两个方向都用：
#   入站 —— 接入方带 Authorization: Bearer <apiKey> 调网关
#   出站 —— 我们回调 notifyUrl 时拿它当 HMAC 密钥签名
# 所以它是密钥，别外传。留空则首次启动随机生成并打到日志里，照抄回这里即可固定。
#
# 这两个值只在首次建库时用一次。之后加分组、签发/停用 Key 都在沙箱页上做，
# 不用重启也不用改这里。
# ------------------------------------------------------------
GROUP_NAME=Sandbox Pay Group
GROUP_API_KEY=

# ------------------------------------------------------------
# 渠道凭证：留空即该渠道不可用，调用时报「未配置」，不影响启动
# ------------------------------------------------------------
# Alipay 沙箱
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# PayPal 沙箱（PAYPAL_ENVIRONMENT: sandbox | live）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ------------------------------------------------------------
# 业务配置，以下均为默认值，不需要改就整段删掉
# ------------------------------------------------------------
# 沙箱模式（关掉则网关接口全部拒绝）
ENABLE_SANDBOX=true

# 限流窗口与配额
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# 手续费率与渠道成本，小数表示（0.006 = 0.6%）
FEE_RATE_ALIPAY=0.006
FEE_RATE_PAYPAL=0.044
FEE_RATE_NATIVE=0
CHANNEL_COST_ALIPAY=0.006
CHANNEL_COST_PAYPAL=0.044
CHANNEL_COST_NATIVE=0
# 单笔最低手续费，单位「分」
FEE_MIN_CENTS=0

# 汇率：拉取失败时用 FALLBACK_CNY_TO_USD，MARGIN 为倍数（1 = 不加价）
EXCHANGE_RATE_PROVIDER=open-er-api
EXCHANGE_RATE_CACHE_TTL_MS=3600000
FALLBACK_CNY_TO_USD=0.14
EXCHANGE_RATE_MARGIN=1

# 自有收款（NATIVE 渠道）收款信息，QR_URL 留空则用订单号生成二维码
NATIVE_PAY_QR_URL=
NATIVE_PAY_ACCOUNT_NAME=Sandbox Pay Official
NATIVE_PAY_ACCOUNT_NO=
NATIVE_PAY_BANK_NAME=
